/* WTH-AI TUI theme — responsive layout */

Screen {
    background: #0d1117;
}

HeaderBar {
    height: 3;
    background: #161b22;
    border: solid #30363d;
    border-title-color: #58a6ff;
    padding: 0 1;
    content-align: left middle;
}

FooterBar {
    height: 1;
    background: #161b22;
    color: #8b949e;
    padding: 0 1;
    dock: bottom;
}

#transcript {
    height: 1fr;
    border: solid #30363d;
    background: #0d1117;
    padding: 0 1;
}

#activity-panel {
    width: 1fr;
    height: 100%;
    border: solid #30363d;
    background: #010409;
    padding: 0 1;
}

#activity-full {
    height: 1fr;
    border: solid #30363d;
    background: #010409;
    padding: 0 1;
}

#sidebar-panel {
    width: 38;
    height: 100%;
    border: solid #30363d;
    background: #161b22;
    padding: 0 1;
}

#input-bar {
    height: 3;
    border: tall #30363d;
    background: #0d1117;
    padding: 0 1;
    dock: bottom;
}

#input-bar:focus {
    border: tall #58a6ff;
}

#input-bar:disabled {
    opacity: 0.55;
    border: tall #484f58;
}

#footer {
    border-top: solid #30363d;
}

#hint-line {
    height: 1;
    color: #8b949e;
    padding: 0 1;
    background: #0d1117;
}

.lower-row {
    height: 12;
    min-height: 10;
    max-height: 16;
}

TabbedContent {
    height: 1fr;
}

TabbedContent > ContentSwitcher {
    height: 1fr;
}

TabPane {
    padding: 0;
}

#findings-pane, #tools-pane, #config-pane {
    height: 1fr;
    padding: 1 2;
    background: #0d1117;
    border: solid #30363d;
}

TranscriptPanel {
    height: 1fr;
}

ActivityPanel {
    height: 1fr;
}

SidebarPanel {
    height: 1fr;
}

InputBar {
    height: 3;
}

InputBar.-disabled {
    color: #484f58;
}

/* Tab highlights */
TabbedContent Tab {
    background: #161b22;
    color: #8b949e;
}

TabbedContent Tab.-active {
    background: #21262d;
    color: #58a6ff;
    text-style: bold;
}
