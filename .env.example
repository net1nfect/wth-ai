# WU-003 (ADR-012): 3 dimensi safety independen, default AMAN. Ubah eksplisit
# hanya kalau paham konsekuensinya -- masing-masing TIDAK lagi mempengaruhi 2
# lainnya (beda dari WTH_UNRESTRICTED lama yang membypass ketiganya sekaligus).
WTH_UNRESTRICTED=0        # dimensi 2: capability ceiling (tool-risk gating)
WTH_REQUIRE_AUTHORIZED=1  # dimensi 1: wajib authorized=yes di scope sebelum testing aktif
WTH_AUTO_APPROVE=0        # dimensi 3: wajib /approve manusia untuk aksi high-risk
