# Docker environment for WTH-AI
ROUTER9_API_KEY=
ROUTER9_BASE_URL=http://9router:20128/v1
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
WTH_HOME=/data/wth-ai

# WU-003 (ADR-012): 3 dimensi safety independen, default AMAN.
WTH_UNRESTRICTED=0        # dimensi 2: capability ceiling (tool-risk gating)
WTH_REQUIRE_AUTHORIZED=1  # dimensi 1: wajib authorized=yes di scope sebelum testing aktif
WTH_AUTO_APPROVE=0        # dimensi 3: wajib /approve manusia untuk aksi high-risk
WTH_SKIP_SETUP=1
